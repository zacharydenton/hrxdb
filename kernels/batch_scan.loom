// Batch scan on the matrix cores: a workgroup scores 64 corpus rows against up
// to 64 queries with 16x16x16 FP16 WMMA, accumulating in FP32. Logical batches
// up to 256 place successive query blocks in adjacent linear workgroups,
// reusing the same corpus rows before advancing to the next row block.
//
// Corpus rows and matrix inputs are FP16, while accumulation and inverse-norm
// scaling stay FP32. Widths through 64 narrow FP32 queries during staging.
// Wider batches pack and transpose queries once per search, allowing both
// operands' matrix fragments to load contiguous halves from LDS.
//
// Eight wave32s tile the 64x64 block 4x2, each holding two 16x16 result
// fragments. Both operands stage 64 reduction components at a time with
// 72-half strides to break bank conflicts. The wide path keeps the inner
// reduction loop rolled to bound live operand registers. Query slots past
// the batch width stage zeros and are never stored. Results publish through
// LDS so each lane writes eight adjacent rows of one query's scores.
// The first tile publishes dense scores. Later tiles also append scores above
// the immutable running k-th bound; dense output remains the overflow fallback.
// Compile-time template selection keeps that work out of the first-tile kernel.
amdgpu.target<gfx1151> @target {subgroup_size = 32}
config.decl @db.batch : %value: index where [range(%value, 8, 256), mul(%value, 8)]
config.decl @db.scan.dimensions : %value: index where [range(%value, 128, 16384), mul(%value, 128)]
template.decl @db.batch.keep(%prune: index, %score: f32, %threshold: f32, %query: index, %row: index, %global_base: index, %capacity_arg: i32, %counts: buffer, %candidate_scores: buffer, %candidate_ids: buffer)
template.def<@db.batch.keep> @db.batch.dense(%prune: index, %score: f32, %threshold: f32, %query: index, %row: index, %global_base: index, %capacity_arg: i32, %counts: buffer, %candidate_scores: buffer, %candidate_ids: buffer) where [eq(%prune, 0)] {
  template.return
}
template.def<@db.batch.keep> @db.batch.pruned(%prune: index, %score: f32, %threshold: f32, %query: index, %row: index, %global_base: index, %capacity_arg: i32, %counts: buffer, %candidate_scores: buffer, %candidate_ids: buffer) where [eq(%prune, 1)] {
  %above = scalar.cmpf ogt, %score, %threshold : f32
  scf.if %above {
    %zero = index.constant 0 : offset
    %width = config.get @db.batch : index
    %capacity0 = index.cast %capacity_arg : i32 to index
    %capacity = index.assume %capacity0 [range(%capacity0, 1, 65536)] : index
    %size = index.mul %width, %capacity : index
    %nv = buffer.view %counts[%zero] : buffer -> view<[%width]xi32>
    %sv = buffer.view %candidate_scores[%zero] : buffer -> view<[%size]xf32>
    %iv = buffer.view %candidate_ids[%zero] : buffer -> view<[%size]xi32>
    %one = scalar.constant 1 : i32
    %slot32 = view.atomic.rmw<addi> %one, %nv[%query] {ordering = relaxed, scope = device} : i32, view<[%width]xi32> -> i32
    %slot0 = index.cast %slot32 : i32 to index
    %fits = index.cmp ult, %slot0, %capacity : index
    scf.if %fits {
      %slot = index.assume %slot0 [range(%slot0, 0, 65535), lt(%slot0, %capacity)] : index
      %base = index.mul %query, %capacity : index
      %out0 = index.add %base, %slot : index
      %out = index.assume %out0 [range(%out0, 0, 16777215), lt(%out0, %size)] : index
      %global = index.add %global_base, %row : index
      %id = index.cast %global : index to i32
      view.store %score, %sv[%out] : f32, view<[%size]xf32>
      view.store %id, %iv[%out] : i32, view<[%size]xi32>
    }
  }
  template.return
}

template.decl @db.batch.scan(%prune: index, %count_arg: i32, %masked_arg: i32, %row_base_arg: i32, %total_arg: i32, %queries_arg: i32, %k_arg: i32, %capacity_arg: i32, %data: buffer, %queries: buffer, %norms: buffer, %bitmap: buffer, %scores: buffer, %running: buffer, %counts: buffer, %candidate_scores: buffer, %candidate_ids: buffer)
template.def<@db.batch.scan> @db.batch.wmma(%prune: index, %count_arg: i32, %masked_arg: i32, %row_base_arg: i32, %total_arg: i32, %queries_arg: i32, %k_arg: i32, %capacity_arg: i32, %data: buffer, %queries: buffer, %norms: buffer, %bitmap: buffer, %scores: buffer, %running: buffer, %counts: buffer, %candidate_scores: buffer, %candidate_ids: buffer) {
  %zero = index.constant 0 : offset
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %m = index.constant 16 : index
  %n = index.constant 16 : index
  %k = index.constant 16 : index
  %batch = config.get @db.batch : index
  %packed_queries = index.cmp uge, %batch, %c128 : index
  %mma_unroll = scf.select %packed_queries, %c1, %c4 : index
  %d = config.get @db.scan.dimensions : index
  %raw = index.cast %count_arg : i32 to index
  %count = index.assume %raw [range(%raw, 1, 262144)] : index
  %tid0 = kernel.workitem.id<x> : index
  %tid = index.assume %tid0 [range(%tid0, 0, 255)] : index
  %linear0 = kernel.workgroup.id<x> : index
  %linear = index.assume %linear0 [range(%linear0, 0, 16383)] : index
  %c63 = index.constant 63 : index
  %batch_rounded = index.add %batch, %c63 : index
  %query_groups = index.div %batch_rounded, %c64 : index
  %group0 = index.div %linear, %query_groups : index
  %group = index.assume %group0 [range(%group0, 0, 4095)] : index
  %q_group = index.rem %linear, %query_groups : index
  %query_base = index.mul %q_group, %c64 : index
  %subgroup0 = kernel.subgroup.id : index
  %subgroup = index.assume %subgroup0 [range(%subgroup0, 0, 7)] : index
  %lane = kernel.subgroup.lane.id : index
  %row_base = index.mul %group, %c64 : index

  %dv = buffer.view %data[%zero] : buffer -> view<[%count]x[%d]xf16>
  %qv = buffer.view %queries[%zero] : buffer -> view<[%d]x[%batch]xf32>
  %pqv = buffer.view %queries[%zero] : buffer -> view<[%batch]x[%d]xf16>
  %nv = buffer.view %norms[%zero] : buffer -> view<[%count]xf32>
  %sv = buffer.view %scores[%zero] : buffer -> view<[%batch]x[%count]xf32>

  // Two 9 KiB staging tiles, whose 18 KiB then holds eight 1 KiB result tiles.
  %lds_bytes = index.constant 18432 : offset
  %query_offset = index.constant 9216 : offset
  %result_bytes = index.constant 1024 : offset
  %lds = buffer.alloca<workgroup> align(16) %lds_bytes : buffer
  %xs = buffer.view %lds[%zero] : buffer -> view<64x72xf16>
  %qs = buffer.view %lds[%query_offset] : buffer -> view<64x72xf16>
  %q_layout = encoding.layout.strided [1, 72] : encoding<layout>
  %q_columns = buffer.view %lds[%query_offset] : buffer -> view<64x64xf16, %q_layout>
  %result_offset = index.scale %subgroup, %result_bytes : index, offset -> offset
  %result = buffer.view %lds[%result_offset] : buffer -> view<16x16xf32>

  %wave_m = index.div %subgroup, %c2 : index
  %wave_n = index.rem %subgroup, %c2 : index
  %wave_row = index.mul %wave_m, %c16 : index
  %wave_col = index.mul %wave_n, %c32 : index
  %wave_col1 = index.add %wave_col, %c16 : index

  // Corpus staging: each thread moves sixteen halves of one row.
  %x_packet = index.rem %tid, %c4 : index
  %x_k = index.mul %x_packet, %c16 : index
  %x_row0 = index.div %tid, %c4 : index
  %x_row = index.assume %x_row0 [range(%x_row0, 0, 63)] : index
  %source_row = index.add %row_base, %x_row : index
  %row_valid = index.cmp ult, %source_row, %count : index
  %safe_row = scf.select %row_valid, %source_row, %c0 : index
  %x_at = index.assume %safe_row [range(%safe_row, 0, 262143), lt(%safe_row, %count)] : index
  // Narrow-batch staging: each thread moves sixteen of one component's query slots,
  // eight at a time; the width is a multiple of eight, so a packet is wholly
  // inside the batch or wholly padding.
  %q_packet = index.rem %tid, %c4 : index
  %q_col = index.mul %q_packet, %c16 : index
  %q_col1 = index.add %q_col, %c8 : index
  %q_k0 = index.div %tid, %c4 : index
  %q_k = index.assume %q_k0 [range(%q_k0, 0, 63)] : index
  %q_global0 = index.add %query_base, %q_col : index
  %q_global1 = index.add %query_base, %q_col1 : index
  %q_live0 = index.cmp ult, %q_global0, %batch : index
  %q_live1 = index.cmp ult, %q_global1, %batch : index

  %zero_x = vector.constant 0.0 : vector<16xf16>
  %zero_q = vector.constant 0.0 : vector<8xf16>
  %zero_acc = vector.constant 0.0 : vector<8xf32>
  %acc_init0 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>
  %acc_init1 = vector.fragment<init> %zero_acc shape [%m, %n] : vector<8xf32>

  %acc0, %acc1 = scf.for %k_base = [%c0 to %d step %c64](%run0 = %acc_init0 : vector<8xf32>, %run1 = %acc_init1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) {
    %x_dim = index.add %k_base, %x_k : index
    %x_values = scf.if %row_valid -> (vector<16xf16>) {
      %loaded = vector.load %dv[%x_at, %x_dim] : view<[%count]x[%d]xf16> -> vector<16xf16>
      scf.yield %loaded : vector<16xf16>
    } else {
      scf.yield %zero_x : vector<16xf16>
    }
    vector.store %x_values, %xs[%x_row, %x_k] : vector<16xf16>, view<64x72xf16>

    scf.if %packed_queries {
      %query_row = index.add %query_base, %x_row : index
      %query_valid = index.cmp ult, %query_row, %batch : index
      %values = scf.if %query_valid -> (vector<16xf16>) {
        %loaded = vector.load %pqv[%query_row, %x_dim] : view<[%batch]x[%d]xf16> -> vector<16xf16>
        scf.yield %loaded : vector<16xf16>
      } else {
        scf.yield %zero_x : vector<16xf16>
      }
      vector.store %values, %qs[%x_row, %x_k] : vector<16xf16>, view<64x72xf16>
    } else {
      %q_dim = index.add %k_base, %q_k : index
      %q_values0 = scf.if %q_live0 -> (vector<8xf16>) {
        %wide = vector.load %qv[%q_dim, %q_global0] : view<[%d]x[%batch]xf32> -> vector<8xf32>
        %narrow = vector.fptrunc %wide : vector<8xf32> to vector<8xf16>
        scf.yield %narrow : vector<8xf16>
      } else {
        scf.yield %zero_q : vector<8xf16>
      }
      %q_values1 = scf.if %q_live1 -> (vector<8xf16>) {
        %wide = vector.load %qv[%q_dim, %q_global1] : view<[%d]x[%batch]xf32> -> vector<8xf32>
        %narrow = vector.fptrunc %wide : vector<8xf32> to vector<8xf16>
        scf.yield %narrow : vector<8xf16>
      } else {
        scf.yield %zero_q : vector<8xf16>
      }
      vector.store %q_values0, %qs[%q_k, %q_col] : vector<8xf16>, view<64x72xf16>
      vector.store %q_values1, %qs[%q_k, %q_col1] : vector<8xf16>, view<64x72xf16>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

    %next0, %next1 = scf.for %k_step = [%c0 to %c64 step %c16](%half0 = %run0 : vector<8xf32>, %half1 = %run1 : vector<8xf32>) -> (vector<8xf32>, vector<8xf32>) unroll(%mma_unroll) {
      %lhs = vector.fragment.load<lhs> %xs[%wave_row, %k_step] shape [%m, %k] : view<64x72xf16> -> vector<16xf16>
      %rhs0 = scf.if %packed_queries -> (vector<16xf16>) {
        %value = vector.fragment.load<rhs> %q_columns[%k_step, %wave_col] shape [%k, %n] : view<64x64xf16, %q_layout> -> vector<16xf16>
        scf.yield %value : vector<16xf16>
      } else {
        %value = vector.fragment.load<rhs> %qs[%k_step, %wave_col] shape [%k, %n] : view<64x72xf16> -> vector<16xf16>
        scf.yield %value : vector<16xf16>
      }
      %rhs1 = scf.if %packed_queries -> (vector<16xf16>) {
        %value = vector.fragment.load<rhs> %q_columns[%k_step, %wave_col1] shape [%k, %n] : view<64x64xf16, %q_layout> -> vector<16xf16>
        scf.yield %value : vector<16xf16>
      } else {
        %value = vector.fragment.load<rhs> %qs[%k_step, %wave_col1] shape [%k, %n] : view<64x72xf16> -> vector<16xf16>
        scf.yield %value : vector<16xf16>
      }
      %out0 = vector.mma %lhs, %rhs0, %half0 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      %out1 = vector.mma %lhs, %rhs1, %half1 : vector<16xf16>, vector<16xf16>, vector<8xf32>
      scf.yield %out0, %out1 : vector<8xf32>, vector<8xf32>
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
    scf.yield %next0, %next1 : vector<8xf32>, vector<8xf32>
  }

  // Each lane publishes one query column and eight adjacent rows of it.
  %zero_i32 = scalar.constant 0 : i32
  %masked = scalar.cmpi ne, %masked_arg, %zero_i32 : i32
  %c31 = index.constant 31 : index
  %total0 = index.cast %total_arg : i32 to index
  %total = index.assume %total0 [range(%total0, 1, 1073741824)] : index
  %global_base0 = index.cast %row_base_arg : i32 to index
  %global_base = index.assume %global_base0 [range(%global_base0, 0, 1073741823)] : index
  %rounded = index.add %total, %c31 : index
  %words = index.div %rounded, %c32 : index
  %bv = buffer.view %bitmap[%zero] : buffer -> view<[%words]xi32>
  %badbits = scalar.constant -8388608 : i32
  %neg = scalar.bitcast %badbits : i32 to f32
  %lane_col = index.rem %lane, %c16 : index
  %lane_half = index.div %lane, %c16 : index
  %lane_row = index.mul %lane_half, %c8 : index
  %tile_row = index.add %wave_row, %lane_row : index
  %first_row = index.add %row_base, %tile_row : index

  scf.for %fragment = [%c0 to %c2 step %c1] unroll {
    %is_second = index.cmp eq, %fragment, %c1 : index
    %chosen = scf.select %is_second, %acc1, %acc0 : vector<8xf32>
    vector.fragment.store<result> %chosen, %result[%c0, %c0] shape [%m, %n] : vector<8xf32>, view<16x16xf32>
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

    %fragment_col = index.mul %fragment, %c16 : index
    %col_base = index.add %wave_col, %fragment_col : index
    %query_local = index.add %col_base, %lane_col : index
    %query0 = index.add %query_base, %query_local : index
    %live = index.cmp ult, %query0, %batch : index
    scf.if %live {
      %query = index.assume %query0 [range(%query0, 0, 255), lt(%query0, %batch)] : index
      %pruning = index.cmp eq, %prune, %c1 : index
      %threshold = scf.if %pruning -> (f32) {
        %n0 = index.cast %queries_arg : i32 to index
        %n = index.assume %n0 [range(%n0, 1, 256)] : index
        %active = index.cmp ult, %query, %n : index
        %bound = scf.if %active -> (f32) {
          %k0 = index.cast %k_arg : i32 to index
          %topk = index.assume %k0 [range(%k0, 1, 1024)] : index
          %size = index.mul %n, %topk : index
          %rv = buffer.view %running[%zero] : buffer -> view<[%size]xf32>
          %base = index.mul %query, %topk : index
          %end = index.add %base, %topk : index
          %last0 = index.sub %end, %c1 : index
          %last = index.assume %last0 [range(%last0, 0, 262143), lt(%last0, %size)] : index
          %value = view.load %rv[%last] : view<[%size]xf32> -> f32
          scf.yield %value : f32
        } else {
          %inf = scalar.constant 0x7f800000 : i32
          %value = scalar.bitcast %inf : i32 to f32
          scf.yield %value : f32
        }
        scf.yield %bound : f32
      } else {
        %value = scalar.constant 0.0 : f32
        scf.yield %value : f32
      }
      %row_end = index.add %first_row, %c8 : index
      %full = index.cmp ule, %row_end, %count : index
      %unmasked = scalar.cmpi eq, %masked_arg, %zero_i32 : i32
      %fast = scalar.andi %full, %unmasked : i1
      scf.if %fast {
        // Gather before publishing, so consecutive stores do not interleave
        // with norm loads. Masked rows and partial packets use the scalar path.
        %at = index.assume %first_row [range(%first_row, 0, 262136), lt(%first_row, %count)] : index
        %inverses = vector.load %nv[%at] : view<[%count]xf32> -> vector<8xf32>
        %packed = scf.for %i = [%c0 to %c8 step %c1](%values = %zero_acc : vector<8xf32>) -> (vector<8xf32>) unroll {
          %local = index.add %lane_row, %i : index
          %sum = view.load %result[%local, %lane_col] : view<16x16xf32> -> f32
          %inverse = vector.extract %inverses[%i] : vector<8xf32> -> f32
          %score = scalar.mulf %sum, %inverse : f32
          %next = vector.insert %score into %values[%i] : f32, vector<8xf32>
          scf.yield %next : vector<8xf32>
        }
        vector.store %packed, %sv[%query, %at] : vector<8xf32>, view<[%batch]x[%count]xf32>
        scf.for %i = [%c0 to %c8 step %c1] unroll {
          %score = vector.extract %packed[%i] : vector<8xf32> -> f32
          %row = index.add %first_row, %i : index
          template.apply<@db.batch.keep>(%prune, %score, %threshold, %query, %row, %global_base, %capacity_arg, %counts, %candidate_scores, %candidate_ids) : (index, f32, f32, index, index, index, i32, buffer, buffer, buffer) -> ()
        }
      } else {
        scf.for %i = [%c0 to %c8 step %c1] unroll {
          %local = index.add %lane_row, %i : index
          %row = index.add %first_row, %i : index
          %valid = index.cmp ult, %row, %count : index
          scf.if %valid {
            %at = index.assume %row [range(%row, 0, 262143), lt(%row, %count)] : index
            %sum = view.load %result[%local, %lane_col] : view<16x16xf32> -> f32
            %inverse = view.load %nv[%at] : view<[%count]xf32> -> f32
            %cosine = scalar.mulf %sum, %inverse : f32
            %excluded = scf.if %masked -> (i1) {
              %global0 = index.add %global_base, %at : index
              %global = index.assume %global0 [range(%global0, 0, 1073741823), lt(%global0, %total)] : index
              %word0 = index.div %global, %c32 : index
              %word = index.assume %word0 [range(%word0, 0, 33554431), lt(%word0, %words)] : index
              %bit = index.rem %global, %c32 : index
              %bits = view.load %bv[%word] : view<[%words]xi32> -> i32
              %shift = index.cast %bit : index to i32
              %shifted = scalar.shrui %bits, %shift : i32
              %one = scalar.constant 1 : i32
              %flag = scalar.andi %shifted, %one : i32
              %test = scalar.cmpi ne, %flag, %zero_i32 : i32
              scf.yield %test : i1
            } else {
              %no = scalar.constant false : i1
              scf.yield %no : i1
            }
            %score = scf.select %excluded, %neg, %cosine : f32
            view.store %score, %sv[%query, %at] : f32, view<[%batch]x[%count]xf32>
            template.apply<@db.batch.keep>(%prune, %score, %threshold, %query, %row, %global_base, %capacity_arg, %counts, %candidate_scores, %candidate_ids) : (index, f32, f32, index, index, index, i32, buffer, buffer, buffer) -> ()
          }
        }
      }
    }
    kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  }
  template.return
}

kernel.def target(@target) export("batch_scan") @batch_scan(%count_arg: i32) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %rows = index.constant 64 : index
  %extra = index.constant 63 : index
  %raw = index.cast %count_arg : i32 to index
  %count = index.assume %raw [range(%raw, 1, 262144)] : index
  %rounded = index.add %count, %extra : index
  %groups = index.div %rounded, %rows : index
  %batch = config.get @db.batch : index
  %batch_rounded = index.add %batch, %extra : index
  %query_groups = index.div %batch_rounded, %rows : index
  %total_groups = index.mul %groups, %query_groups : index
  kernel.launch.config workgroups(%total_groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count_arg: i32, %masked_arg: i32, %row_base_arg: i32, %total_arg: i32, %data: buffer, %queries: buffer, %norms: buffer, %bitmap: buffer, %scores: buffer) {
  %mode = index.constant 0 : index
  %unused = scalar.constant 0 : i32
  template.apply<@db.batch.scan>(%mode, %count_arg, %masked_arg, %row_base_arg, %total_arg, %unused, %unused, %unused, %data, %queries, %norms, %bitmap, %scores, %scores, %scores, %scores, %scores) : (index, i32, i32, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> ()
  kernel.return
}

kernel.def target(@target) export("batch_scan_pruned") @batch_scan_pruned(%count_arg: i32) {
  %one = index.constant 1 : index
  %threads = index.constant 256 : index
  %rows = index.constant 64 : index
  %extra = index.constant 63 : index
  %raw = index.cast %count_arg : i32 to index
  %count = index.assume %raw [range(%raw, 1, 262144)] : index
  %rounded = index.add %count, %extra : index
  %groups = index.div %rounded, %rows : index
  %batch = config.get @db.batch : index
  %batch_rounded = index.add %batch, %extra : index
  %query_groups = index.div %batch_rounded, %rows : index
  %total_groups = index.mul %groups, %query_groups : index
  kernel.launch.config workgroups(%total_groups, %one, %one) workgroup_size(%threads, %one, %one) : index
} launch(%count_arg: i32, %masked_arg: i32, %row_base_arg: i32, %total_arg: i32, %queries_arg: i32, %k_arg: i32, %capacity_arg: i32, %data: buffer, %queries: buffer, %norms: buffer, %bitmap: buffer, %scores: buffer, %running: buffer, %counts: buffer, %candidate_scores: buffer, %candidate_ids: buffer) {
  %mode = index.constant 1 : index
  template.apply<@db.batch.scan>(%mode, %count_arg, %masked_arg, %row_base_arg, %total_arg, %queries_arg, %k_arg, %capacity_arg, %data, %queries, %norms, %bitmap, %scores, %running, %counts, %candidate_scores, %candidate_ids) : (index, i32, i32, i32, i32, i32, i32, i32, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer) -> ()
  kernel.return
}
